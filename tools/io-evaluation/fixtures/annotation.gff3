##gff-version 3
##sequence-region chr1 1 100
##sequence-region chr2 1 100
chr1	fixture	gene	1	20	.	+	.	ID=g1;Name=Gene1;Note=two%20words
chr1	fixture	mRNA	1	20	.	+	.	ID=t1;Name=Tx1;Parent=g1
chr1	fixture	mRNA	1	20	.	+	.	ID=t2;Name=Tx2;Parent=g1
chr1	fixture	exon	1	5	2.5	+	.	ID=e1;Name=Exon1;Parent=t1,t2
chr1	fixture	CDS	2	5	.	+	0	ID=c1;Name=CDS1;Parent=t1
chr2	fixture	gene	10	20	.	-	.	ID=g2;Name=Gene2
chr2	fixture	mRNA	10	20	.	-	.	ID=t3;Name=Tx3;Parent=g2
chr2	fixture	exon	10	20	0	-	.	ID=e2;Name=Exon2;Parent=t3
